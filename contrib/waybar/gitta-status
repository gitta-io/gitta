#!/bin/sh
# Waybar custom module for gitta — editor/agent/AI-frontend agnostic.
#
# Point it at ONE repo, or at a ROOT directory (e.g. ~/src): if the path is not
# itself a gitta repo, it aggregates every repo's .gitta/audit.jsonl found under
# it, so you set it once and never repoint — new gitta repos are picked up
# automatically. It shows gitta's impact: merges REFUSED (bad code kept off the
# branch) vs merges that passed and LANDED, in different colours (a refusal is an
# alert, a landing is good), with serious refusals (credentials, security,
# weakened checks, policy) in red with a ⚠. It only reads the trail; it never
# runs the gitta binary, so it is safe to poll.
#   gitta-status ~/src            # aggregate every gitta repo under ~/src
#   gitta-status ~/src/myrepo     # a single repo
# Requires: jq. Colours use Pango markup; override the GITTA_COLOR_* env vars.
set -u
target="${1:-${GITTA_REPO:-$PWD}}"

if [ -f "$target/.gitta/audit.jsonl" ]; then
  nrepos=1
  trails="$target/.gitta/audit.jsonl"
else
  # Treat as a root: find every repo's trail under it. The directory scan is slow
  # on big trees, so cache the list of trails and refresh it at most every
  # GITTA_SCAN_TTL seconds; each poll just reads the cache. A new gitta repo shows
  # up within that TTL. The trails themselves are always read fresh below.
  key=$(printf '%s' "$target" | cksum | cut -d' ' -f1)
  dir="${XDG_RUNTIME_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}}/gitta-integrations"
  mkdir -p "$dir" 2>/dev/null
  cache="$dir/trails-$key"
  mt=$(stat -c %Y "$cache" 2>/dev/null || stat -f %m "$cache" 2>/dev/null || echo 0)
  if [ "$(( $(date +%s) - mt ))" -ge "${GITTA_SCAN_TTL:-60}" ]; then
    find "$target" -maxdepth "${GITTA_SCAN_DEPTH:-6}" \
      \( -name node_modules -o -name target -o -name .git -o -name _dogfood_target -o -name .cache -o -name vendor \) -prune -o \
      -type f -path '*/.gitta/audit.jsonl' -print > "$cache.$$" 2>/dev/null && mv "$cache.$$" "$cache"
  fi
  trails=$(cat "$cache" 2>/dev/null)
  [ -n "$trails" ] || { printf '{"text":""}\n'; exit 0; }
  nrepos=$(printf '%s\n' "$trails" | grep -c .)
fi

icon="${GITTA_ICON:-$(printf '\357\207\223')}"   # U+F1D3 git glyph (Nerd Font)
warn="${GITTA_WARN_ICON:-$(printf '\357\201\261')}"  # U+F071 warning (Nerd Font, matches other module icons)
ci="${GITTA_COLOR_ICON:-#89b4fa}"   # module identity
cok="${GITTA_COLOR_OK:-#a6e3a1}"    # landed — good
cw="${GITTA_COLOR_WARN:-#f9e2af}"   # refused, routine (tests, merge)
cb="${GITTA_COLOR_BAD:-#f38ba8}"    # refused, serious
cm="${GITTA_COLOR_MUTE:-#6c7086}"   # separators, "clear"

printf '%s\n' "$trails" | while IFS= read -r f; do [ -n "$f" ] && cat "$f"; done | jq -cs \
  --arg icon "$icon" --arg warn "$warn" --arg ci "$ci" --arg cok "$cok" \
  --arg cw "$cw" --arg cb "$cb" --arg cm "$cm" --argjson nrepos "$nrepos" '
  def span($c; $t): "<span foreground=\"\($c)\">\($t)</span>";
  (["credentials","weakened checks","security","code page","policy"]) as $serious
  | map(select(.event=="landed" or .event=="land_refused" or .event=="agent_started")) as $evs
  | ($evs | map(select(.event=="landed")) | length) as $landed
  | ($evs | map(select(.event=="land_refused"))) as $ref
  | ($ref | length) as $refused
  | ($ref | map(select(.data.check as $c | $serious | any(. == $c))) | length) as $scary
  | ($ref | group_by(.data.check // "gate")
          | map((length|tostring) + " × " + (.[0].data.check // "gate"))) as $byreason
  | ($evs | sort_by(.time) | last) as $e
  | (if $scary > 0 then $cb else $cw end) as $cref
  | ( span($ci; $icon)
      + (if $refused > 0 then " " + span($cref; (if $scary > 0 then ($warn + " ") else "" end) + ($refused|tostring) + " refused") else "" end)
      + (if $landed > 0 then " " + span($cm; "·") + " " + span($cok; ($landed|tostring) + " ok")
         elif $refused == 0 then " " + span($cm; "clear") else "" end)
    ) as $text
  | {
      text: $text,
      class: (if ($scary > 0 or ($e.event // "") == "land_refused") then "refused"
              elif $refused > 0 then "caught" else "ok" end),
      tooltip: (
        (if $refused > 0
           then "gitta refused " + ($refused|tostring) + " merge(s):\n  " + ($byreason | join("\n  "))
                + (if $scary > 0 then "\n⚠ includes serious refusals (credentials, security, weakened checks, policy)" else "" end)
           else "gitta has refused nothing yet" end)
        + "\n" + ($landed|tostring) + " merge(s) passed the gate and landed"
        + (if $nrepos > 1 then " · across " + ($nrepos|tostring) + " repos" else "" end)
        + (if $e != null then "\nlast: " + $e.event + " " + ($e.agent // "") + " at " + $e.time else "" end)
      )
    }'
